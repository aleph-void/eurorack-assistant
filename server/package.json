{
  "name": "eurorack-assistant-server",
  "version": "0.1.0",
  "description": "Express API for asking LLMs about your eurorack modules",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:down": "node scripts/migrate.js down",
    "create-admin": "node scripts/create-admin.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.12.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "moment": "^2.30.1",
    "pg-mem": "^3.0.14",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
