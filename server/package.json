{
  "name": "eurorack-assistant-server",
  "version": "0.1.0",
  "description": "Express API for asking LLMs about your eurorack modules",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:down": "node scripts/migrate.js down",
    "create-admin": "node scripts/create-admin.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "moment": "^2.31.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
