# eurorack-backup — one full backup to S3 (./backup-s3.sh), run by
# eurorack-backup.timer once a day. Running the service by hand takes a backup
# now: `sudo systemctl start eurorack-backup.service`; its output is in
# `journalctl -u eurorack-backup`.
#
# TEMPLATE: @APP_DIR@ is substituted at install time. ./setup.sh installs it
# (with the timer) whenever BACKUP_S3_BUCKET is set in .env; to do it by hand:
#
#   sed -e "s|@APP_DIR@|$PWD|" deploy/eurorack-backup.service | sudo tee /etc/systemd/system/eurorack-backup.service
#   sudo install -m 644 deploy/eurorack-backup.timer /etc/systemd/system/eurorack-backup.timer
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now eurorack-backup.timer

[Unit]
Description=Eurorack Assistant daily backup to S3
Documentation=https://github.com/aleph-void/eurorack-assistant
# A backup is of the running stack: pg_dump runs in the db container and the
# file zip in the server one.
Requires=docker.service
After=docker.service network-online.target eurorack-assistant.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@APP_DIR@
# The script reads .env itself (bucket, prefix, retention, AWS credentials),
# so nothing is configured here.
ExecStart=@APP_DIR@/backup-s3.sh
# A whole-studio archive can take a long while to stream; let it finish.
TimeoutStartSec=6h
# Backups contend with the app for the disk and the network; take the hint.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
